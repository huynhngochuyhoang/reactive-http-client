<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.huynhngochuyhoang</groupId>
    <artifactId>reactive-http-client</artifactId>
    <version>4.1.0</version>
    <packaging>pom</packaging>

    <name>reactive-http-client</name>
    <description>Reactive HTTP Client – multi-module Maven project</description>
    <url>https://github.com/huynhngochuyhoang/reactive-http-client</url>

    <modules>
        <module>reactive-http-client-starter</module>
        <module>reactive-http-client-test</module>
        <module>reactive-http-client-otel</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.0.0</spring-boot.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.7.0</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.4</maven-gpg-plugin.version>
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-antrun-plugin.version>3.1.0</maven-antrun-plugin.version>
        <central-publishing-maven-plugin.version>0.10.0</central-publishing-maven-plugin.version>
        <japicmp-maven-plugin.version>0.26.0</japicmp-maven-plugin.version>
        <japicmp-groovy.version>4.0.30</japicmp-groovy.version>
        <jmh.version>1.37</jmh.version>
        <latest.published.version>4.0.0</latest.published.version>
        <api.compatibility.baseline.version>4.0.0</api.compatibility.baseline.version>
        <api.compatibility.break-on-binary-incompatible>true</api.compatibility.break-on-binary-incompatible>
        <api.compatibility.break-on-source-incompatible>true</api.compatibility.break-on-source-incompatible>
        <api.compatibility.ignore-missing-classes>false</api.compatibility.ignore-missing-classes>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>reactive-http-client-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>reactive-http-client-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>reactive-http-client-otel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>huynhngochuyhoang</id>
            <name>Huynh Ngoc Huy Hoang</name>
            <url>https://github.com/huynhngochuyhoang</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/huynhngochuyhoang/reactive-http-client.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/huynhngochuyhoang/reactive-http-client.git</developerConnection>
        <url>https://github.com/huynhngochuyhoang/reactive-http-client</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/huynhngochuyhoang/reactive-http-client/issues</url>
    </issueManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.12.1</version>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                                <version>${spring-boot.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-maven-plugin.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <publishingServerId>central</publishingServerId>
                        <autoPublish>false</autoPublish>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <doclint>none</doclint>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release-smoke</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <reactive.http.release-smoke>true</reactive.http.release-smoke>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>benchmarks</id>
            <modules>
                <module>reactive-http-client-benchmarks</module>
            </modules>
        </profile>

        <profile>
            <id>major-api-report</id>
            <properties>
                <api.compatibility.break-on-binary-incompatible>false</api.compatibility.break-on-binary-incompatible>
                <api.compatibility.break-on-source-incompatible>false</api.compatibility.break-on-source-incompatible>
                <api.compatibility.ignore-missing-classes>true</api.compatibility.ignore-missing-classes>
            </properties>
        </profile>

        <profile>
            <id>api-compatibility</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>${maven-antrun-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>reject-current-api-baseline</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <condition property="api.compatibility.baseline.is-current">
                                            <equals arg1="${api.compatibility.baseline.version}" arg2="${project.version}"/>
                                        </condition>
                                        <fail if="api.compatibility.baseline.is-current"
                                              message="api.compatibility.baseline.version must point to the last published release, not the current reactor version ${project.version}."/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>resolve-published-api-baseline-pom</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>get</goal>
                                </goals>
                                <configuration>
                                    <artifact>${project.groupId}:${project.artifactId}:${api.compatibility.baseline.version}:pom</artifact>
                                    <transitive>false</transitive>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>${japicmp-maven-plugin.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.apache.groovy</groupId>
                                <artifactId>groovy-jsr223</artifactId>
                                <version>${japicmp-groovy.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <oldVersion>
                                <dependency>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>${project.artifactId}</artifactId>
                                    <version>${api.compatibility.baseline.version}</version>
                                    <type>jar</type>
                                </dependency>
                            </oldVersion>
                            <newVersion>
                                <file>
                                    <path>${project.build.directory}/${project.build.finalName}.jar</path>
                                </file>
                            </newVersion>
                            <breakBuildOnBinaryIncompatibleModifications>${api.compatibility.break-on-binary-incompatible}</breakBuildOnBinaryIncompatibleModifications>
                            <breakBuildOnSourceIncompatibleModifications>${api.compatibility.break-on-source-incompatible}</breakBuildOnSourceIncompatibleModifications>
                            <parameter>
                                <ignoreMissingClasses>${api.compatibility.ignore-missing-classes}</ignoreMissingClasses>
                                <accessModifier>public</accessModifier>
                                <onlyModified>true</onlyModified>
                                <ignoreMissingOptionalDependency>true</ignoreMissingOptionalDependency>
                                <postAnalysisScript>${maven.multiModuleProjectDirectory}/scripts/japicmp-annotation-default-compatibility.groovy</postAnalysisScript>
                                <includes>
                                    <include>io.github.huynhngochuyhoang.httpstarter.annotation</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.auth</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.enable</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.exception</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.filter</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.observability</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.config.ReactiveHttpClientProperties*</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.DefaultErrorDecoder</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.DefaultHttpExchangeLogger</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.ErrorResponseContext</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.ErrorResponseMapper</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.FileAttachment</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.HttpExchangeLogContext</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.HttpExchangeLogger</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.MethodMetadataCache</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.MethodMetadata*</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.ProblemDetailErrorResponseMapper</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.*ReactiveHttpClientJsonCodec</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.ReactiveHttpClientCustomizer</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.ReactiveHttpClientLifecycleContext</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.ReactiveHttpClientLifecycleHook</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.ReactiveHttpClientDiagnosticsProvider*</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.ReactiveHttpClientDiagnosticsSnapshot</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.ReactiveHttpClientContractSnapshot*</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.RequestContext</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.RequestContextContributor</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.RequestContextSnapshot</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.ResilienceOperatorApplier*</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.core.SensitiveHeaders</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.test</include>
                                    <include>io.github.huynhngochuyhoang.httpstarter.otel</include>
                                </includes>
                            </parameter>
                        </configuration>
                        <executions>
                            <execution>
                                <id>compare-public-api</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
