<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.huynhngochuyhoang</groupId>
        <artifactId>reactive-http-client</artifactId>
        <version>3.5.0</version>
    </parent>

    <artifactId>reactive-http-client-benchmarks</artifactId>
    <name>reactive-http-client-benchmarks</name>
    <description>JMH benchmarks for reactive-http-client against raw WebClient and Spring HTTP Interface</description>

    <properties>
        <benchmark.result.dir>${project.build.directory}/benchmark-reports</benchmark.result.dir>
        <benchmark.commit>unknown</benchmark.commit>
        <benchmark.starter.version>${project.version}</benchmark.starter.version>
        <benchmark.include>.*Benchmark.*</benchmark.include>
        <benchmark.stack.context>Spring Boot 4 release baseline</benchmark.stack.context>
        <benchmark.jackson.artifact>${tools.jackson.core:jackson-databind:jar}</benchmark.jackson.artifact>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>reactive-http-client-starter</artifactId>
            <version>${benchmark.starter.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-ratelimiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>resolve-benchmark-dependency-paths</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>benchmarks</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.huynhngochuyhoang.httpstarter.benchmarks.BenchmarkRunner</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>benchmark-discovery</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>run-benchmark-discovery</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>-jar</argument>
                                        <argument>${project.build.directory}/benchmarks.jar</argument>
                                        <argument>${benchmark.include}</argument>
                                        <argument>-l</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>benchmark-smoke</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>run-benchmark-smoke</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>-Dbenchmark.project.version=${project.version}</argument>
                                        <argument>-Dbenchmark.starter.version=${benchmark.starter.version}</argument>
                                        <argument>-Dbenchmark.api.compatibility.baseline.version=${api.compatibility.baseline.version}</argument>
                                        <argument>-Dbenchmark.spring-boot.version=${spring-boot.version}</argument>
                                        <argument>-Dbenchmark.stack.context=${benchmark.stack.context}</argument>
                                        <argument>-Dbenchmark.spring-webflux.artifact=${org.springframework:spring-webflux:jar}</argument>
                                        <argument>-Dbenchmark.reactor-netty.artifact=${io.projectreactor.netty:reactor-netty-http:jar}</argument>
                                        <argument>-Dbenchmark.netty.artifact=${io.netty:netty-codec-http:jar}</argument>
                                        <argument>-Dbenchmark.jackson.artifact=${benchmark.jackson.artifact}</argument>
                                        <argument>-Dbenchmark.micrometer.artifact=${io.micrometer:micrometer-core:jar}</argument>
                                        <argument>-Dbenchmark.opentelemetry.artifact=${io.opentelemetry:opentelemetry-api:jar}</argument>
                                        <argument>-Dbenchmark.commit=${benchmark.commit}</argument>
                                        <argument>-Dorg.slf4j.simpleLogger.logFile=${project.build.directory}/benchmark-logger.log</argument>
                                        <argument>-jar</argument>
                                        <argument>${project.build.directory}/benchmarks.jar</argument>
                                        <argument>${benchmark.include}</argument>
                                        <argument>-wi</argument>
                                        <argument>1</argument>
                                        <argument>-i</argument>
                                        <argument>1</argument>
                                        <argument>-f</argument>
                                        <argument>1</argument>
                                        <argument>-r</argument>
                                        <argument>1s</argument>
                                        <argument>-w</argument>
                                        <argument>1s</argument>
                                        <argument>-rf</argument>
                                        <argument>json</argument>
                                        <argument>-rff</argument>
                                        <argument>${benchmark.result.dir}/smoke-only-jmh.json</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>benchmark-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>run-benchmark-release</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>-Dbenchmark.project.version=${project.version}</argument>
                                        <argument>-Dbenchmark.starter.version=${benchmark.starter.version}</argument>
                                        <argument>-Dbenchmark.api.compatibility.baseline.version=${api.compatibility.baseline.version}</argument>
                                        <argument>-Dbenchmark.spring-boot.version=${spring-boot.version}</argument>
                                        <argument>-Dbenchmark.stack.context=${benchmark.stack.context}</argument>
                                        <argument>-Dbenchmark.spring-webflux.artifact=${org.springframework:spring-webflux:jar}</argument>
                                        <argument>-Dbenchmark.reactor-netty.artifact=${io.projectreactor.netty:reactor-netty-http:jar}</argument>
                                        <argument>-Dbenchmark.netty.artifact=${io.netty:netty-codec-http:jar}</argument>
                                        <argument>-Dbenchmark.jackson.artifact=${benchmark.jackson.artifact}</argument>
                                        <argument>-Dbenchmark.micrometer.artifact=${io.micrometer:micrometer-core:jar}</argument>
                                        <argument>-Dbenchmark.opentelemetry.artifact=${io.opentelemetry:opentelemetry-api:jar}</argument>
                                        <argument>-Dbenchmark.commit=${benchmark.commit}</argument>
                                        <argument>-Dorg.slf4j.simpleLogger.logFile=${project.build.directory}/benchmark-logger.log</argument>
                                        <argument>-jar</argument>
                                        <argument>${project.build.directory}/benchmarks.jar</argument>
                                        <argument>${benchmark.include}</argument>
                                        <argument>-wi</argument>
                                        <argument>5</argument>
                                        <argument>-i</argument>
                                        <argument>5</argument>
                                        <argument>-f</argument>
                                        <argument>2</argument>
                                        <argument>-prof</argument>
                                        <argument>gc</argument>
                                        <argument>-rf</argument>
                                        <argument>json</argument>
                                        <argument>-rff</argument>
                                        <argument>${benchmark.result.dir}/release-jmh.json</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>benchmark-published-baseline</id>
            <properties>
                <benchmark.result.dir>${project.build.directory}/benchmark-reports/published-starter-${benchmark.starter.version}</benchmark.result.dir>
                <maven.javadoc.skip>true</maven.javadoc.skip>
            </properties>
        </profile>
        <profile>
            <id>benchmark-compare</id>
            <properties>
                <benchmark.compare.current>${benchmark.result.dir}/release-jmh.json</benchmark.compare.current>
                <benchmark.compare.baseline>${benchmark.result.dir}/published-starter-${api.compatibility.baseline.version}/release-jmh.json</benchmark.compare.baseline>
                <benchmark.compare.output>${benchmark.result.dir}/benchmark-comparison.md</benchmark.compare.output>
                <benchmark.compare.fail-on-review>false</benchmark.compare.fail-on-review>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>compare-benchmark-reports</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>io.github.huynhngochuyhoang.httpstarter.benchmarks.BenchmarkReportComparator</mainClass>
                                    <arguments>
                                        <argument>--current</argument>
                                        <argument>${benchmark.compare.current}</argument>
                                        <argument>--baseline</argument>
                                        <argument>${benchmark.compare.baseline}</argument>
                                        <argument>--output</argument>
                                        <argument>${benchmark.compare.output}</argument>
                                        <argument>--fail-on-review=${benchmark.compare.fail-on-review}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>


    </profiles>
</project>
