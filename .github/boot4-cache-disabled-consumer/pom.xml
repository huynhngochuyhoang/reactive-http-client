<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <parent>
  <groupId>org.springframework.boot</groupId>
  <artifactId>spring-boot-starter-parent</artifactId>
  <version>4.0.0</version>
 </parent>
 <groupId>io.github.huynhngochuyhoang</groupId>
 <artifactId>reactive-http-client-boot4-cache-disabled-consumer</artifactId>
 <version>1.0.0-SNAPSHOT</version>
 <properties>
  <java.version>21</java.version>
  <reactive-http-client.version>4.4.0</reactive-http-client.version>
 </properties>
 <dependencies>
  <dependency>
   <groupId>io.github.huynhngochuyhoang</groupId>
   <artifactId>reactive-http-client-starter</artifactId>
   <version>${reactive-http-client.version}</version>
  </dependency>
  <dependency>
   <groupId>org.springframework.boot</groupId>
   <artifactId>spring-boot-starter-webflux</artifactId>
  </dependency>
  <dependency>
   <groupId>org.springframework.boot</groupId>
   <artifactId>spring-boot-starter-test</artifactId>
   <scope>test</scope>
  </dependency>
 </dependencies>
 <profiles>
  <profile>
   <id>v31-current-parity</id>
   <activation><property><name>consumer.v31.parity</name><value>true</value></property></activation>
   <build><plugins><plugin>
    <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
    <executions><execution><id>add-v31-test-source</id><phase>generate-test-sources</phase>
     <goals><goal>add-test-source</goal></goals>
     <configuration><sources><source>../boot4-consumer/src/v31-test/java</source></sources></configuration>
    </execution></executions>
   </plugin></plugins></build>
  </profile>
 </profiles>
</project>
